{
  "name": "sensiblemd",
  "private": true,
  "version": "0.0.0",
  "description": "A reader-first desktop Markdown application for macOS, Windows, and Linux.",
  "author": "K. Sherbondy",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5175 --strictPort",
    "dev:desktop": "concurrently -k \"npm run dev\" \"wait-on http://127.0.0.1:5175 && electron . --dev\"",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "lint": "oxlint",
    "preview": "vite preview",
    "package:local": "node scripts/package-local.mjs",
    "package:mac:arm64": "npm run build && electron-builder --mac dmg --arm64",
    "package:mac:x64": "npm run build && electron-builder --mac dmg --x64",
    "package:win:x64": "npm run build && electron-builder --win nsis --x64",
    "package:win:arm64": "npm run build && electron-builder --win nsis --arm64",
    "package:linux:x64": "npm run build && electron-builder --linux AppImage deb --x64",
    "package:linux:arm64": "npm run build && electron-builder --linux AppImage deb --arm64",
    "package:mac:dir": "npm run build && electron-builder --mac --dir",
    "package:win:dir": "npm run build && electron-builder --win --dir",
    "package:linux:dir": "npm run build && electron-builder --linux --dir"
  },
  "build": {
    "appId": "com.sensiblemd.app",
    "productName": "SensibleMD",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "md",
        "name": "Markdown Document",
        "role": "Editor",
        "rank": "Default"
      }
    ],
    "mac": {
      "target": "dmg",
      "icon": "src/assets/icons/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "src/assets/icons/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "src/assets/icons/icon.png"
    }
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.11",
    "lucide-react": "^1.40.0",
    "mdast-util-to-string": "^4.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0"
  }
}
